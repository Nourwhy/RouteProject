@model SignInDto
@{

	ViewData["Title"] = "SignIn";
	Layout = "~/Views/Shared/_AuthLayout.cshtml";


}

<h1>Sign In</h1>
<div class="main-agileinfo">
	<div class="agileits-top">
		<div asp-validation-summary="All" class="m-3 alert alert-info"></div>
		<form asp-action="SignIn">
	
			<input class="text email" asp-for="Email" placeholder="Email" required="">
			<input class="text" asp-for="Password" placeholder="Password" required="">
	
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="RememberMe" class="checkbox" required="">
					<span> Remember Me?</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNIN">
		</form>
	@* 	<a asp-action="GoogleLogin" class="login-btn">Login with Google</a>
		<br>
		<a asp-action="FacebookLogin" class="login-btn">Login with Facebook</a> *@

		<p>Don't have an Account? <a asp-action="SignUp"> Create An Account!</a></p>
		<p><a asp-action="ForgetPassword">Forget Password?</a></p>
	</div>
</div>

@section ValidationSection {

	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>


}
